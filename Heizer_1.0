/**
 * ============================================================================
 * Shelly BLU Gateway Gen3 – Heizungssteuerung Wohnzimmer (wozi_heizung.js)
 * ============================================================================
 * Hardware & Virtuelle Komponenten:
 *   - BLU Button (MAC_BTN):   Manuelles Umschalten Komfort <-> Eco
 *   - BLU Door/Window (W1/W2): Fenster Küche (MAC_W1) & Wohnzimmer (MAC_W2)
 *   - 3x Shelly BLU TRV:      IDs 200, 201, 202
 *   - Shelly Plus Plug S:     SNPL-00112EU (192.168.188.194) – LED-Ring & Taster
 *   - Virtueller Schalter:    boolean:200 (true = Komfort, false = Eco)
 *   - Virtuelle Zahlen:       number:200 (Komfort °C), number:201 (Eco °C),
 *                             number:202 (Lüften °C)
 *
 * Funktionsübersicht:
 *   1. Morgen-Lüftungs-Freigabe:
 *      - Täglich zwischen 01:00 und 05:59 Uhr wird ventDone einmalig auf false
 *        zurückgesetzt (inkl. Reboot-Schutz via Script.storage).
 *      - Erst wenn danach mindestens ein Fenster geöffnet wurde (ventOpened)
 *        und alle Fenster wieder geschlossen sind, wechselt das Skript auf
 *        Komfort (22 °C / boolean:200 = true).
 *   2. Abend-Lüftungs-Regel (ab 21:00 Uhr):
 *      - Wird zwischen 21:00 Uhr und 00:59 Uhr ein Fenster geschlossen,
 *        schaltet das Skript unabhängig vom vorherigen Zustand immer auf Eco.
 *   3. Manueller Vorrang & Fenster-Überwachung:
 *      - BLU-Button, HTTP-Endpunkt (/script/<id>/toggle) oder boolean:200
 *        schalten jederzeit zwischen Komfort und Eco um.
 *      - Während offener Fenster wird auf 5 °C abgesenkt; danach greift
 *        Morgen-Komfort, Abend-Eco oder die Wiederherstellung der Sollwerte.
 *   4. Echte TRV-Verifikation & LED-Farbring (Plug S):
 *      - Prüft nach 20s den tatsächlichen target_C der TRVs inkl. Retry.
 *      - Plug-Ring: 15 % Dauerlicht, 80 % Blinken während der Stellphase.
 * ============================================================================
 */

// === 1. KONFIGURATION & ZUSTAND ===
var CFG = {
  MAC_BTN: "7c:c6:b6:80:05:7a",
  MAC_W1:  "f4:01:cc:21:d9:4f",
  MAC_W2:  "f4:01:cc:21:dd:02",
  TRVS:    [200, 201, 202],
  SW_ID:   200, N_KOMF: 200, N_ECO: 201, N_LUEFT: 202,
  PLUG_IP: "192.168.188.194",
  RESET_HOUR_START: 1,
  RESET_HOUR_END: 6,
  NIGHT_ECO_HOUR: 21,
  T_STEP:  4000, T_VERIF: 20000, T_CLOCK: 30000, T_BLINK: 2000, T_DEBOUNCE: 3000,
  MAX_CALLS: 2, MAX_RETRIES: 1,
  LED_BRI_STEADY: 15,
  LED_BRI_BLINK_HIGH: 80,
  LED_BRI_BLINK_LOW: 15
};

var TEMPS = { komf: 22, eco: 16, lueft: 5 };

// RGB-Skala 0..100 für Shelly Plus Plug S (SNPL-00112EU)
var PLUG_COLORS = {
  komf:  [100, 28, 0],   // Orange  = Komfort
  eco:   [0, 100, 0],    // Grün    = Eco
  lueft: [0, 75, 100]    // Eisblau = Lüften
};

var ST = {
  komf: true, w1: false, w2: false, over: false, modePend: false,
  ventDone: true, ventOpened: false, lastResetTs: 0,
  targets: {}, cache: {}, acked: {}, activePkt: {}, expected: {},
  inFlight: 0, q: [], tQ: null, tV: null, token: 0, retries: 0,
  plugMode: "komf", plugBlinking: false, plugBlinkOn: true,
  tBlink: null, plugInFlight: false, plugNext: null, lastToggle: 0
};

// === 2. HILFSFUNKTIONEN & PERSISTENZ ===
function callRpc(method, params, cb) {
  ST.inFlight++;
  Shelly.call(method, params || {}, function (res, err, msg) {
    ST.inFlight = Math.max(0, ST.inFlight - 1);
    if (cb) cb(res, err, msg);
  });
}

function getTrvTargetFromStatus(res, id) {
  if (!res) return null;
  var trv = res["blutrv:" + id];
  if (trv && typeof trv.target_C === "number") return trv.target_C;
  return null;
}

function getCurrentHour() {
  var sys = Shelly.getComponentStatus("sys");
  if (!sys || !sys.time || sys.time.length < 2) return null;
  var hour = parseInt(sys.time.substr(0, 2), 10);
  return isNaN(hour) ? null : hour;
}

function isNightVentTime() {
  var hour = getCurrentHour();
  if (hour === null) return false;
  return (hour >= CFG.NIGHT_ECO_HOUR || hour < CFG.RESET_HOUR_START);
}

function saveState() {
  try {
    Script.storage.setItem("wozi_trv_state", JSON.stringify({
      t: ST.targets,
      vd: ST.ventDone,
      vo: ST.ventOpened,
      rt: ST.lastResetTs
    }));
  } catch (e) { print("Fehler beim Speichern: " + e); }
}

function loadState() {
  try {
    var d = JSON.parse(Script.storage.getItem("wozi_trv_state") || "{}");
    ST.targets = d.t || {};
    ST.ventDone = (typeof d.vd === "boolean") ? d.vd : false;
    ST.ventOpened = (typeof d.vo === "boolean") ? d.vo : false;
    ST.lastResetTs = (typeof d.rt === "number") ? d.rt : 0;
  } catch (e) {
    ST.targets = {};
    ST.ventDone = false;
    ST.ventOpened = false;
    ST.lastResetTs = 0;
  }
  ST.over = false;
  ST.modePend = false;
}

function checkDailyReset() {
  var sys = Shelly.getComponentStatus("sys");
  if (!sys || !sys.time || sys.time.length < 2) return;

  var hour = parseInt(sys.time.substr(0, 2), 10);
  if (isNaN(hour)) return;

  // Zeitfenster 01:00 - 05:59 Uhr: einmalig pro Tag zurücksetzen
  if (hour >= CFG.RESET_HOUR_START && hour < CFG.RESET_HOUR_END) {
    var nowTs = (typeof sys.unixtime === "number") ? sys.unixtime : 0;
    // Mindestens 12 Stunden Abstand zum letzten Reset verhindern Mehrfach-Resets
    if (nowTs === 0 ? ST.ventDone : (nowTs - ST.lastResetTs > 43200)) {
      ST.ventDone = false;
      ST.ventOpened = false;
      if (nowTs > 0) ST.lastResetTs = nowTs;
      saveState();
      print(sys.time + " Uhr: Tages-Reset durchgeführt (Morgen-Lüftung scharfgeschaltet).");
    }
  }
}

// === 2b. SHELLY PLUS PLUG S – FARBRING & BLINKSTEUERUNG ===
function sendPlugLed(rgb, bri) {
  if (!CFG.PLUG_IP) return;

  if (ST.plugInFlight) {
    ST.plugNext = { rgb: rgb, bri: bri };
    return;
  }

  ST.plugInFlight = true;
  var payload = {
    config: {
      leds: {
        mode: "switch",
        colors: {
          "switch:0": {
            on:  { rgb: rgb, brightness: bri },
            off: { rgb: rgb, brightness: bri }
          }
        }
      }
    }
  };

  Shelly.call("HTTP.POST", {
    url: "http://" + CFG.PLUG_IP + "/rpc/PLUGS_UI.SetConfig",
    content_type: "application/json",
    body: JSON.stringify(payload),
    timeout: 3
  }, function (res, err, msg) {
    ST.plugInFlight = false;
    if (ST.plugNext !== null) {
      var nxt = ST.plugNext;
      ST.plugNext = null;
      sendPlugLed(nxt.rgb, nxt.bri);
    }
  });
}

function startPlugBlink(mode) {
  ST.plugMode = mode;
  ST.plugBlinking = true;
  ST.plugBlinkOn = true;

  if (ST.tBlink) {
    Timer.clear(ST.tBlink);
    ST.tBlink = null;
  }

  var col = PLUG_COLORS[mode] || PLUG_COLORS.eco;
  sendPlugLed(col, CFG.LED_BRI_BLINK_HIGH);

  ST.tBlink = Timer.set(CFG.T_BLINK, true, function () {
    if (!ST.plugBlinking) return;
    ST.plugBlinkOn = !ST.plugBlinkOn;
    var c = PLUG_COLORS[ST.plugMode] || PLUG_COLORS.eco;
    sendPlugLed(c, ST.plugBlinkOn ? CFG.LED_BRI_BLINK_HIGH : CFG.LED_BRI_BLINK_LOW);
  });
}

function stopPlugBlink(finalMode) {
  if (finalMode) ST.plugMode = finalMode;
  ST.plugBlinking = false;
  ST.plugBlinkOn = true;

  if (ST.tBlink) {
    Timer.clear(ST.tBlink);
    ST.tBlink = null;
  }

  sendPlugLed(PLUG_COLORS[ST.plugMode] || PLUG_COLORS.eco, CFG.LED_BRI_STEADY);
}

// === 3. STEUERUNG & WARTESCHLANGE ===
function processQ(token) {
  if (token !== ST.token) return;

  if (ST.q.length === 0) {
    print("Prüfe TRV-Sollwerte in " + Math.round(CFG.T_VERIF / 1000) + "s...");
    ST.tV = Timer.set(CFG.T_VERIF, false, function () { ST.tV = null; verifyQ(token); });
    return;
  }

  if (ST.inFlight >= CFG.MAX_CALLS) {
    ST.tQ = Timer.set(3000, false, function () { processQ(token); });
    return;
  }

  // mJS-kompatibler Shift-Ersatz
  var task = ST.q[0];
  var nextQ = [];
  for (var i = 1; i < ST.q.length; i++) nextQ.push(ST.q[i]);
  ST.q = nextQ;

  print("TRV " + task.id + " -> " + task.lbl + " (" + task.temp + " °C)");

  callRpc("BluTrv.Call", { id: task.id, method: "TRV.SetTarget", params: { id: 0, target_C: task.temp } }, function (r, e, m) {
    if (e === 0) {
      print("TRV " + task.id + ": Befehl an BLE-Queue übergeben (" + task.temp + " °C)");
    } else {
      print("TRV " + task.id + " Hinweis: " + m);
    }
  });

  ST.tQ = Timer.set(ST.q.length > 0 ? CFG.T_STEP : 100, false, function () { processQ(token); });
}

function verifyQ(token) {
  if (token !== ST.token) return;
  if (ST.inFlight >= CFG.MAX_CALLS) {
    ST.tV = Timer.set(5000, false, function () { ST.tV = null; verifyQ(token); });
    return;
  }

  callRpc("Shelly.GetStatus", {}, function (res) {
    if (token !== ST.token) return;
    var missing = [], log = [];

    for (var i = 0; i < CFG.TRVS.length; i++) {
      var id = CFG.TRVS[i], exp = ST.expected[id];
      var statusTemp = getTrvTargetFromStatus(res, id);
      if (statusTemp !== null) ST.cache[id] = statusTemp;

      var act = (statusTemp !== null) ? statusTemp : ST.cache[id];
      var ok = (ST.acked[id] === true) || (act === exp);

      if (ok) {
        ST.acked[id] = true;
        ST.cache[id] = exp;
        log.push(id + ":OK(" + exp + "°C)");
      } else {
        log.push(id + ":OFFEN(Ist " + (act !== undefined ? act + "°C" : "?") + " / Soll " + exp + "°C)");
        missing.push({ id: id, temp: exp, lbl: "Retry" });
      }
    }

    print("Prüfung (Rd " + (ST.retries + 1) + "): " + log.join(" | "));

    if (missing.length === 0) {
      print("Alle TRVs erfolgreich bestätigt.");
      stopPlugBlink(ST.plugMode);
    } else if (ST.retries < CFG.MAX_RETRIES) {
      ST.retries++;
      ST.q = missing;
      processQ(token);
    } else {
      print("Hinweis: Max Retries erreicht.");
      stopPlugBlink(ST.plugMode);
    }
  });
}

function enqueueAll(tempObj, lbl) {
  ST.token++; ST.retries = 0; ST.expected = {}; ST.acked = {}; ST.q = [];
  if (ST.tQ) { Timer.clear(ST.tQ); ST.tQ = null; }
  if (ST.tV) { Timer.clear(ST.tV); ST.tV = null; }

  // Zielfarbe für das Blinken während der Stellphase bestimmen
  var targetLed = (lbl === "Lueften") ? "lueft" : (ST.komf ? "komf" : "eco");
  startPlugBlink(targetLed);

  for (var i = 0; i < CFG.TRVS.length; i++) {
    var id = CFG.TRVS[i];
    var t = tempObj !== null ? tempObj : (ST.targets[id] || (ST.komf ? TEMPS.komf : TEMPS.eco));
    ST.expected[id] = t;
    ST.q.push({ id: id, temp: t, lbl: lbl });
  }
  processQ(ST.token);
}

function updateLogic() {
  var open = ST.w1 || ST.w2;

  if (open && !ST.over) {
    var switchingInProgress = (ST.q.length > 0 || ST.tV !== null);
    ST.over = true;
    ST.modePend = false;

    // Falls Morgen-Lüftung noch aussteht, Öffnen des Fensters sofort merken & speichern
    if (!ST.ventDone && !ST.ventOpened) {
      ST.ventOpened = true;
      saveState();
      print("Morgen-Lüftung registriert (Fenster geöffnet).");
    }

    if (switchingInProgress) {
      var targetModeTemp = ST.komf ? TEMPS.komf : TEMPS.eco;
      for (var i = 0; i < CFG.TRVS.length; i++) {
        ST.targets[CFG.TRVS[i]] = targetModeTemp;
      }
      saveState();
      print("Umschaltung lief noch -> Zielwert " + targetModeTemp + " °C für alle TRVs gesichert");
      enqueueAll(TEMPS.lueft, "Lueften");
    } else {
      callRpc("Shelly.GetStatus", {}, function (res) {
        if (!ST.over) return;
        for (var i = 0; i < CFG.TRVS.length; i++) {
          var id = CFG.TRVS[i];
          var statusTemp = getTrvTargetFromStatus(res, id);
          ST.targets[id] = (statusTemp !== null) ? statusTemp : (ST.cache[id] || (ST.komf ? TEMPS.komf : TEMPS.eco));
          print("TRV " + id + ": Sollwert " + ST.targets[id] + " °C gesichert");
        }
        saveState();
        enqueueAll(TEMPS.lueft, "Lueften");
      });
    }
  } else if (!open && ST.over) {
    ST.over = false;

    if (isNightVentTime()) {
      ST.ventOpened = false;
      ST.modePend = false;
      ST.komf = false;
      for (var k = 0; k < CFG.TRVS.length; k++) {
        ST.targets[CFG.TRVS[k]] = TEMPS.eco;
      }
      saveState();
      print("Abend-Lüftung (ab " + CFG.NIGHT_ECO_HOUR + ":00 Uhr) abgeschlossen -> Aktiviere Eco (" + TEMPS.eco + " °C).");
      callRpc("Boolean.Set", { id: CFG.SW_ID, value: false });
      enqueueAll(TEMPS.eco, "Eco");
    } else if (!ST.ventDone && ST.ventOpened) {
      ST.ventDone = true;
      ST.ventOpened = false;
      ST.modePend = false;
      ST.komf = true;
      for (var j = 0; j < CFG.TRVS.length; j++) {
        ST.targets[CFG.TRVS[j]] = TEMPS.komf;
      }
      saveState();
      print("Morgen-Lüftung abgeschlossen -> Aktiviere Komfort (" + TEMPS.komf + " °C).");
      callRpc("Boolean.Set", { id: CFG.SW_ID, value: true });
      enqueueAll(TEMPS.komf, "Komfort");
    } else if (ST.modePend) {
      ST.modePend = false;
      print("Lüftung beendet -> Übernehme vorgemerkten Modus: " + (ST.komf ? "Komfort" : "Eco"));
      enqueueAll(ST.komf ? TEMPS.komf : TEMPS.eco, ST.komf ? "Komfort" : "Eco");
    } else {
      print("Lüftung beendet -> Stelle gesicherte Werte wieder her (ventDone=" + ST.ventDone + ", ventOpened=" + ST.ventOpened + ").");
      enqueueAll(null, "Restore");
    }
  }
}

function applyMode(isKomf) {
  ST.komf = isKomf;

  // Manuelles Umschalten auf Komfort gilt sofort als Freigabe für den Tag
  if (isKomf && (!ST.ventDone || ST.ventOpened)) {
    ST.ventDone = true;
    ST.ventOpened = false;
    saveState();
    print("Komfort manuell aktiviert -> Morgen-Lüftung als erledigt markiert.");
  }

  if (ST.over) {
    ST.modePend = true;
    print("Modus gemerkt, greift nach dem Schließen.");
  } else {
    enqueueAll(ST.komf ? TEMPS.komf : TEMPS.eco, ST.komf ? "Komfort" : "Eco");
  }
}

// === 4. EVENT, HTTP & BLUETOOTH HANDLER ===
var toggleEndpointPath = "";
if (typeof HTTPServer !== "undefined" && HTTPServer.registerEndpoint) {
  toggleEndpointPath = HTTPServer.registerEndpoint("toggle", function (req, res) {
    var now = Shelly.getUptimeMs();
    if ((req && req.method === "HEAD") || (now - ST.lastToggle < CFG.T_DEBOUNCE)) {
      res.code = 200;
      res.headers = [["Content-Type", "application/json"]];
      res.body = JSON.stringify({ ok: true, debounced: true, mode: ST.komf ? "Komfort" : "Eco" });
      res.send();
      return;
    }

    ST.lastToggle = now;
    var nK = !ST.komf;
    print("Plug/HTTP Taster -> Wechsle zu " + (nK ? "Komfort" : "Eco"));
    applyMode(nK);
    callRpc("Boolean.Set", { id: CFG.SW_ID, value: nK });

    res.code = 200;
    res.headers = [["Content-Type", "application/json"]];
    res.body = JSON.stringify({ ok: true, mode: nK ? "Komfort" : "Eco" });
    res.send();
  });
}

Shelly.addStatusHandler(function (e) {
  if (!e || !e.component) return;

  if (e.component.indexOf("blutrv:") === 0 && e.delta && typeof e.delta.target_C === "number") {
    var trvId = parseInt(e.component.split(":")[1], 10);
    ST.cache[trvId] = e.delta.target_C;
    if (ST.expected[trvId] === e.delta.target_C) ST.acked[trvId] = true;
    return;
  }

  var v = (e.delta && e.delta.value !== undefined) ? e.delta.value : (e.info && e.info.value !== undefined ? e.info.value : null);
  if (v === null) return;

  if (e.component === "boolean:" + CFG.SW_ID && ST.komf !== v) applyMode(v);
  else if (e.component === "number:" + CFG.N_KOMF && v !== TEMPS.komf) { TEMPS.komf = v; if (ST.komf) applyMode(true); }
  else if (e.component === "number:" + CFG.N_ECO && v !== TEMPS.eco)   { TEMPS.eco = v;  if (!ST.komf) applyMode(false); }
  else if (e.component === "number:" + CFG.N_LUEFT && v !== TEMPS.lueft) { TEMPS.lueft = v; if (ST.over) enqueueAll(TEMPS.lueft, "Lueften"); }
});

function parseBT(hex, lastPkt) {
  var r = { pkt: lastPkt, btn: false, win: null };
  if (!hex || (parseInt(hex.substr(0, 2), 16) & 1)) return r;

  var i = 2;
  while (i + 2 <= hex.length) {
    var obj = parseInt(hex.substr(i, 2), 16), val = parseInt(hex.substr(i + 2, 2), 16);
    if (obj === 0x00) { if (val === lastPkt) return r; r.pkt = val; i += 4; }
    else if (obj === 0x3A) { r.btn = val > 0; i += 4; }
    else if (obj === 0x2D || obj === 0x11 || obj === 0x1A) { r.win = val > 0; i += 4; }
    else {
      var skip = [0x01,0x15,0x20,0x21,0x2E,0x46].indexOf(obj) >= 0 ? 4 :
                 [0x02,0x03,0x3F,0x40,0x41,0x43,0x44,0x45,0x51,0x52].indexOf(obj) >= 0 ? 6 :
                 [0x05,0x42].indexOf(obj) >= 0 ? 8 : 99;
      if (skip === 99) break;
      i += skip;
    }
  }
  return r;
}

BLE.Scanner.Subscribe(function (ev, res) {
  if (ev !== BLE.Scanner.SCAN_RESULT || !res || !res.service_data || !res.service_data.fcd2) return;
  var mac = res.addr.toLowerCase();
  if (mac !== CFG.MAC_BTN && mac !== CFG.MAC_W1 && mac !== CFG.MAC_W2) return;

  var hex = "";
  for (var i = 0; i < res.service_data.fcd2.length; i++) {
    var h = res.service_data.fcd2.charCodeAt(i).toString(16);
    hex += (h.length === 1 ? "0" : "") + h;
  }

  var d = parseBT(hex, ST.activePkt[mac] || -1);
  if (d.pkt === (ST.activePkt[mac] || -1)) return;
  ST.activePkt[mac] = d.pkt;

  if (mac === CFG.MAC_BTN && d.btn) {
    print("Taster -> Wechsle zu " + (!ST.komf ? "Komfort" : "Eco"));
    var nK = !ST.komf; applyMode(nK);
    callRpc("Boolean.Set", { id: CFG.SW_ID, value: nK });
  }
  else if (mac === CFG.MAC_W1 && d.win !== null && ST.w1 !== d.win) {
    ST.w1 = d.win; print("Fenster Küche: " + (ST.w1 ? "AUF" : "ZU")); updateLogic();
  }
  else if (mac === CFG.MAC_W2 && d.win !== null && ST.w2 !== d.win) {
    ST.w2 = d.win; print("Fenster Wozi: " + (ST.w2 ? "AUF" : "ZU")); updateLogic();
  }
});

// === 5. TAGES-RESET & INITIALISIERUNG ===
Timer.set(CFG.T_CLOCK, true, checkDailyReset);

if (BLE.Scanner.isRunning && !BLE.Scanner.isRunning()) {
  BLE.Scanner.start({ duration_ms: BLE.Scanner.INFINITE_SCAN, active: false });
}
loadState();
checkDailyReset();

callRpc("Shelly.GetStatus", {}, function (res) {
  if (!res) return;
  if (res["boolean:" + CFG.SW_ID]) ST.komf = res["boolean:" + CFG.SW_ID].value;

  var nK = res["number:" + CFG.N_KOMF], nE = res["number:" + CFG.N_ECO], nL = res["number:" + CFG.N_LUEFT];
  if (nK && typeof nK.value === "number") TEMPS.komf = nK.value; else callRpc("Number.Set", { id: CFG.N_KOMF, value: TEMPS.komf });
  if (nE && typeof nE.value === "number") TEMPS.eco = nE.value; else callRpc("Number.Set", { id: CFG.N_ECO, value: TEMPS.eco });
  if (nL && typeof nL.value === "number") TEMPS.lueft = nL.value; else callRpc("Number.Set", { id: CFG.N_LUEFT, value: TEMPS.lueft });

  for (var i = 0; i < CFG.TRVS.length; i++) {
    var id = CFG.TRVS[i];
    var t = getTrvTargetFromStatus(res, id);
    ST.cache[id] = (t !== null) ? t : (ST.komf ? TEMPS.komf : TEMPS.eco);
  }

  // Initiale LED-Farbe am Shelly Plus Plug S setzen (15 % Dauerlicht)
  stopPlugBlink(ST.komf ? "komf" : "eco");

  var sysTime = (res.sys && res.sys.time) ? res.sys.time : "?";
  print("Skript gestartet (" + sysTime + " Uhr). Modus: " + (ST.komf ? "Komfort" : "Eco") + " | Morgen-Lüftung erledigt: " + (ST.ventDone ? "Ja" : "Nein"));
});
