 * SPDX-License-Identifier: BSL-1.0
 * Licensed under the Boost Software License 1.0 (https://www.boost.org/LICENSE_1_0.txt).
 *
 * Funktion:
 * Steuert 3x Shelly BLU TRV lokal anhand von 2 Fenstersensoren, Hauptschalter und App-Slidern:
 * - Hauptschalter (boolean:200 / BLU-Taster): Schaltet zwischen Komfort (number:200) und Eco (number:201).
 * - Fenstersensoren (ODER-Logik): Sichert aktuelle TRV-Sollwerte aus dem lokalen Cache und setzt Lueften (number:202).
 * - Alle Fenster wieder ZU: Stellt vorherige TRV-Sollwerte wieder her (bzw. übernimmt
 *   einen während des Lüftens geänderten Komfort/Eco-Modus).
 * - Slot-Wächter & Nachfass-Logik: Verhindert "Too many calls in progress" bei hängenden BLE-Timeouts.
 *
 * Komponenten:
 * - Gateway:         Shelly BLU Gateway Gen3 (S3GW-1DBT001)
 * - Virtuell:        boolean:200 ("Wozi Heizung"), number:200 ("Komfort"),
 *                    number:201 ("Eco"), number:202 ("Lueften")
 * - Thermostate:     3x Shelly BLU TRV (bthomedevice:200, 201, 202)
 * - Taster:          Shelly BLU Button / BLU H&T (7c:c6:b6:80:05:7a)
 * - Fenstersensoren: Küche (f4:01:cc:21:d9:4f), Wozi links (f4:01:cc:21:dd:02)
 */

// === KONFIGURATION ===
var BLU_BUTTON_MAC       = "7c:c6:b6:80:05:7a"; // Taster (BLU H&T / BLU Button)
var WIN1_MAC             = "f4:01:cc:21:d9:4f"; // Fenster Küche
var WIN2_MAC             = "f4:01:cc:21:dd:02"; // Wozi Fenster links

var SWITCH_ID            = 200;              // boolean:200 (Wozi Heizung: true = Komfort, false = Eco)
var NUM_KOMFORT_ID       = 200;              // number:200 (Komfort)
var NUM_ECO_ID           = 201;              // number:201 (Eco)
var NUM_LUEFTEN_ID       = 202;              // number:202 (Lueften)
var TRV_IDS              = [200, 201, 202];  // bthomedevice:200, 201, 202

// Fallback-Temperaturen (falls ein Slider noch keinen Wert hat)
var tempKomfort          = 22;
var tempEco              = 16;
var tempLueften          = 5;
var LOG_INTERVAL_SEC     = 300;              // Zyklischer Log in Sekunden (300 = 5 Min., 0 = aus)
var STEP_DELAY_MS        = 4000;             // Abstand zwischen zwei TRV-Befehlen (4s)
var VERIFY_DELAY_MS      = 20000;            // Wartezeit nach Durchlauf bis zur Prüfung (20s)
var MAX_VERIFY_ROUNDS    = 1;                // Max. 1 gezielte Wiederholung (schützt vor RPC-Überlauf)
var MAX_IN_FLIGHT_CALLS  = 2;                // Max. 2 offene BLE-Calls gleichzeitig (Limit der Engine ist 5)

// Zustandsspeicher
var isKomfort            = true;
var win1Open             = false;
var win2Open             = false;
var windowOverride       = false;
var modeChangedWhileOpen = false;
var savedTargets         = {};     // z. B. { "200": 22.0, "201": 21.5, "202": 22.0 }
var currentTrvTargets    = {};     // Live-Cache der aktuellen Sollwerte

var lastBtnPkt           = -1;
var lastWin1Pkt          = -1;
var lastWin2Pkt          = -1;
var lastWin1Ms           = -1;
var lastWin2Ms           = -1;
var encWarned            = {};

var callQueue            = [];
var dispatchToken        = 0;
var dispatchTimer        = null;
var verifyTimer          = null;
var expectedTargets      = {};
var ackedTrvs            = {};
var currentActionLabel   = "";
var verifyRound          = 0;
var inFlightCalls        = 0;      // Zählt aktuell noch nicht beendete Shelly.call-Aufrufe

// === PERSISTENZ ===
function saveState() {
  try {
    Script.storage.setItem("wozi_trv_preset_state", JSON.stringify({
      windowOverride: windowOverride,
      modeChangedWhileOpen: modeChangedWhileOpen,
      savedTargets: savedTargets
    }));
  } catch (e) {}
}

function loadState() {
  try {
    var raw = Script.storage.getItem("wozi_trv_preset_state");
    if (raw) {
      var data = JSON.parse(raw);
      if (typeof data.windowOverride === "boolean") windowOverride = data.windowOverride;
      if (typeof data.modeChangedWhileOpen === "boolean") modeChangedWhileOpen = data.modeChangedWhileOpen;
      if (data.savedTargets) savedTargets = data.savedTargets;
    }
  } catch (e) {}
}

// === 1. DISPATCH-QUEUE MIT SLOT-WÄCHTER & GEZIELTER WIEDERHOLUNG ===
function verifyAndRetry(myToken) {
  if (myToken !== dispatchToken) return;

  // Falls noch zu viele alte BLE-Timeouts im Hintergrund hängen, 5s warten statt RPC-Limit zu sprengen
  if (inFlightCalls > MAX_IN_FLIGHT_CALLS) {
    print("Prüfung wartet noch auf freie RPC-Slots (aktiv: " + inFlightCalls + ")...");
    verifyTimer = Timer.set(5000, false, function () {
      verifyAndRetry(myToken);
    });
    return;
  }

  inFlightCalls++;
  Shelly.call("Shelly.GetStatus", {}, function (res) {
    inFlightCalls = Math.max(0, inFlightCalls - 1);
    if (myToken !== dispatchToken) return;

    var statusParts = [];
    var missingTasks = [];

    for (var i = 0; i < TRV_IDS.length; i++) {
      var id = TRV_IDS[i];
      var key = String(id);
      var comp = res ? res["bthomedevice:" + id] : null;
      var cachedTemp = (comp && typeof comp.target_C === "number") ? comp.target_C : currentTrvTargets[key];

      if (typeof cachedTemp === "number") {
        currentTrvTargets[key] = cachedTemp;
      }

      var wantedTemp = expectedTargets[key];
      var confirmed = (ackedTrvs[key] === true) || (typeof cachedTemp === "number" && cachedTemp === wantedTemp);

      if (confirmed) {
        ackedTrvs[key] = true;
        statusParts.push(id + ":OK(" + wantedTemp + "°C)");
      } else {
        statusParts.push(id + ":OFFEN(soll " + wantedTemp + "°C, ist " + (typeof cachedTemp === "number" ? cachedTemp + "°C" : "?") + ")");
        missingTasks.push({
          action: "DIRECT",
          trvId: id,
          targetTemp: wantedTemp,
          label: currentActionLabel + " [Retry]"
        });
      }
    }

    print("Prüfung (Runde " + (verifyRound + 1) + "): [" + statusParts.join(" | ") + "]");

    if (missingTasks.length === 0) {
      print("Alle 3 TRVs bestätigt.");
      return;
    }

    if (verifyRound < MAX_VERIFY_ROUNDS) {
      verifyRound++;
      print("Fehlende Quittung bei " + missingTasks.length + " TRV(s) -> sende erneut...");
      callQueue = missingTasks;
      processQueue(myToken);
    } else {
      print("Hinweis: Nicht alle TRVs haben quittiert (BLE-Bus ausgelastet).");
    }
  });
}

function processQueue(myToken) {
  if (myToken !== dispatchToken) return;

  if (callQueue.length === 0) {
    print("Befehle abgesetzt -> prüfe Quittungen in " + Math.round(VERIFY_DELAY_MS / 1000) + "s...");
    verifyTimer = Timer.set(VERIFY_DELAY_MS, false, function () {
      verifyAndRetry(myToken);
    });
    return;
  }

  // Slot-Schutz: Wenn bereits 2 BLE-Calls noch auf ihre Antwort warten, 3s pausieren
  if (inFlightCalls >= MAX_IN_FLIGHT_CALLS) {
    dispatchTimer = Timer.set(3000, false, function () {
      processQueue(myToken);
    });
    return;
  }

  var task = callQueue[0];
  var nextQueue = [];
  for (var i = 1; i < callQueue.length; i++) {
    nextQueue.push(callQueue[i]);
  }
  callQueue = nextQueue;

  var key = String(task.trvId);
  var targetTemp = task.targetTemp;

  if (task.action === "RESTORE_TEMP") {
    var fallback = isKomfort ? tempKomfort : tempEco;
    targetTemp = (typeof savedTargets[key] === "number") ? savedTargets[key] : fallback;
  }

  expectedTargets[key] = targetTemp;
  print("TRV " + task.trvId + " -> sende " + task.label + " (" + targetTemp + " °C)");

  inFlightCalls++;
  Shelly.call("BluTrv.Call", {
    id: task.trvId,
    method: "TRV.SetTarget",
    params: { id: 0, target_C: targetTemp }
  }, function (res, errCode, errMsg) {
    inFlightCalls = Math.max(0, inFlightCalls - 1);
    if (myToken === dispatchToken && errCode === 0 && expectedTargets[key] === targetTemp) {
      ackedTrvs[key] = true;
      currentTrvTargets[key] = targetTemp;
      print("TRV " + task.trvId + ": Quittung OK (" + targetTemp + " °C)");
    } else if (myToken === dispatchToken && errCode !== 0) {
      print("TRV " + task.trvId + ": RPC-Meldung '" + errMsg + "'");
    }
  });

  if (callQueue.length > 0) {
    dispatchTimer = Timer.set(STEP_DELAY_MS, false, function () {
      processQueue(myToken);
    });
  } else {
    processQueue(myToken);
  }
}

function enqueueAll(action, targetTemp, label) {
  dispatchToken++;
  if (dispatchTimer !== null) {
    Timer.clear(dispatchTimer);
    dispatchTimer = null;
  }
  if (verifyTimer !== null) {
    Timer.clear(verifyTimer);
    verifyTimer = null;
  }

  ackedTrvs = {};
  expectedTargets = {};
  currentActionLabel = label;
  verifyRound = 0;
  callQueue = [];

  for (var i = 0; i < TRV_IDS.length; i++) {
    callQueue.push({
      action: action,
      trvId: TRV_IDS[i],
      targetTemp: targetTemp,
      label: label
    });
  }
  processQueue(dispatchToken);
}

// Aktuelle Solltemperaturen sofort aus dem lokalen Gateway-Cache sichern (0 ms, kein Funk)
function snapshotCurrentTargetsFromGateway(callback) {
  if (inFlightCalls > MAX_IN_FLIGHT_CALLS) {
    // Fallback aus lokalem Script-Cache, falls Gateway-RPC gerade voll ist
    for (var j = 0; j < TRV_IDS.length; j++) {
      var k = String(TRV_IDS[j]);
      if (typeof currentTrvTargets[k] === "number") {
        savedTargets[k] = currentTrvTargets[k];
      } else if (typeof savedTargets[k] !== "number") {
        savedTargets[k] = isKomfort ? tempKomfort : tempEco;
      }
      print("TRV " + TRV_IDS[j] + ": Sollwert " + savedTargets[k] + " °C (Cache) gesichert");
    }
    saveState();
    if (callback) callback();
    return;
  }

  inFlightCalls++;
  Shelly.call("Shelly.GetStatus", {}, function (res) {
    inFlightCalls = Math.max(0, inFlightCalls - 1);
    for (var i = 0; i < TRV_IDS.length; i++) {
      var id = TRV_IDS[i];
      var key = String(id);
      var compKey = "bthomedevice:" + id;
      var foundTemp = null;

      if (typeof currentTrvTargets[key] === "number") {
        foundTemp = currentTrvTargets[key];
      } else if (res && res[compKey] && typeof res[compKey].target_C === "number") {
        foundTemp = res[compKey].target_C;
      }

      if (typeof foundTemp === "number") {
        savedTargets[key] = foundTemp;
      } else if (typeof savedTargets[key] !== "number") {
        savedTargets[key] = isKomfort ? tempKomfort : tempEco;
      }
      print("TRV " + id + ": Sollwert " + savedTargets[key] + " °C gesichert");
    }
    saveState();
    if (callback) callback();
  });
}

// === 2. STEUERLOGIK FÜR FENSTER, TASTER & SLIDER ===
function onWindowStateChanged() {
  var anyOpen = (win1Open || win2Open);

  if (anyOpen && !windowOverride) {
    windowOverride = true;
    modeChangedWhileOpen = false;
    saveState();
    print("Fenster OFFEN -> Sollwerte sichern & Lueften (" + tempLueften + " °C) setzen");
    snapshotCurrentTargetsFromGateway(function () {
      enqueueAll("SET_TEMP", tempLueften, "Lueften");
    });

  } else if (!anyOpen && windowOverride) {
    windowOverride = false;
    saveState();
    if (modeChangedWhileOpen) {
      modeChangedWhileOpen = false;
      saveState();
      var targetTemp = isKomfort ? tempKomfort : tempEco;
      var label = isKomfort ? "Komfort" : "Eco";
      print("Alle Fenster ZU -> Geänderten Modus '" + label + "' (" + targetTemp + " °C) setzen");
      enqueueAll("SET_TEMP", targetTemp, label);
    } else {
      print("Alle Fenster ZU -> Vorherige Solltemperaturen wiederherstellen");
      enqueueAll("RESTORE_TEMP", null, "Restore");
    }
  }
}

function applyModeChange(newKomfort) {
  isKomfort = newKomfort;
  var label = isKomfort ? "Komfort" : "Eco";
  var targetTemp = isKomfort ? tempKomfort : tempEco;

  if (windowOverride) {
    modeChangedWhileOpen = true;
    saveState();
    print("Modus auf '" + label + "' geändert (wird aktiviert, sobald Fenster geschlossen sind)");
  } else {
    print("Modus aktiv -> '" + label + "' (" + targetTemp + " °C) setzen");
    enqueueAll("SET_TEMP", targetTemp, label);
  }
}

// === 3. ZYKLISCHER STATUS-LOG ===
function formatAge(lastMs) {
  if (lastMs < 0) return "kein Signal";
  var diffSec = Math.round((Shelly.getUptimeMs() - lastMs) / 1000);
  if (diffSec < 60) return "vor " + diffSec + "s";
  return "vor " + Math.round(diffSec / 60) + "m";
}

function logStatus() {
  var aktivText = windowOverride
    ? "LUEFTEN (" + tempLueften + " °C, Fenster offen)"
    : (isKomfort ? "KOMFORT (" + tempKomfort + " °C)" : "ECO (" + tempEco + " °C)");

  print(
    "[STATUS] Aktiv: " + aktivText +
    " | Slider [K:" + tempKomfort + " / E:" + tempEco + " / L:" + tempLueften + "]" +
    " | Küche: " + (win1Open ? "OFFEN" : "ZU") + " (" + formatAge(lastWin1Ms) + ")" +
    " | Wozi links: " + (win2Open ? "OFFEN" : "ZU") + " (" + formatAge(lastWin2Ms) + ")" +
    " | Gesichert: " + JSON.stringify(savedTargets)
  );
}

if (LOG_INTERVAL_SEC > 0) {
  Timer.set(LOG_INTERVAL_SEC * 1000, true, logStatus);
}

// === 4. VIRTUELLE KOMPONENTEN & TRV-STATUS ÜBERWACHEN ===
function handleComponentChange(comp, val) {
  if (comp === "boolean:" + SWITCH_ID && typeof val === "boolean") {
    if (val !== isKomfort) {
      applyModeChange(val);
    }
  } else if (comp === "number:" + NUM_KOMFORT_ID && typeof val === "number" && val !== tempKomfort) {
    tempKomfort = val;
    print("Slider Komfort geändert auf: " + tempKomfort + " °C");
    if (isKomfort) {
      if (windowOverride) {
        modeChangedWhileOpen = true;
        saveState();
      } else {
        enqueueAll("SET_TEMP", tempKomfort, "Komfort");
      }
    }
  } else if (comp === "number:" + NUM_ECO_ID && typeof val === "number" && val !== tempEco) {
    tempEco = val;
    print("Slider Eco geändert auf: " + tempEco + " °C");
    if (!isKomfort) {
      if (windowOverride) {
        modeChangedWhileOpen = true;
        saveState();
      } else {
        enqueueAll("SET_TEMP", tempEco, "Eco");
      }
    }
  } else if (comp === "number:" + NUM_LUEFTEN_ID && typeof val === "number" && val !== tempLueften) {
    tempLueften = val;
    print("Slider Lueften geändert auf: " + tempLueften + " °C");
    if (windowOverride) {
      enqueueAll("SET_TEMP", tempLueften, "Lueften");
    }
  }
}

Shelly.addStatusHandler(function (event) {
  if (!event || !event.component) return;

  if (event.component.indexOf("bthomedevice:") === 0 && event.delta && typeof event.delta.target_C === "number") {
    var trvKey = event.component.split(":")[1];
    currentTrvTargets[trvKey] = event.delta.target_C;
    if (expectedTargets[trvKey] === event.delta.target_C) {
      ackedTrvs[trvKey] = true;
    }
    return;
  }

  var val = undefined;
  if (event.delta && typeof event.delta.value !== "undefined") {
    val = event.delta.value;
  } else if (event.info && typeof event.info.value !== "undefined") {
    val = event.info.value;
  }

  if (typeof val !== "undefined") {
    handleComponentChange(event.component, val);
  }
});

// === 5. BTHOME-SCANNER FÜR TASTER & BLU-FENSTERSENSOREN ===
function parseBTHome(rawHex, lastPkt, mac) {
  var res = { valid: false, pktId: lastPkt, button: false, windowOpen: null };
  if (!rawHex || rawHex.length < 4) return res;

  var devInfo = parseInt(rawHex.substr(0, 2), 16);
  if ((devInfo & 0x01) !== 0) {
    if (!encWarned[mac]) {
      encWarned[mac] = true;
      print("WARNUNG: Gerät " + mac + " sendet verschlüsselt! Bitte in der Shelly BLU App 'Encryption' deaktivieren.");
    }
    return res;
  }

  var idx = 2;
  while (idx + 2 <= rawHex.length) {
    var objId = parseInt(rawHex.substr(idx, 2), 16);
    if (objId === 0x00 && idx + 4 <= rawHex.length) {
      var pktId = parseInt(rawHex.substr(idx + 2, 2), 16);
      if (pktId === lastPkt) return res;
      res.pktId = pktId;
      res.valid = true;
      idx += 4;
    } else if (objId === 0x3A && idx + 4 <= rawHex.length) {
      if (parseInt(rawHex.substr(idx + 2, 2), 16) > 0) res.button = true;
      idx += 4;
    } else if ((objId === 0x2D || objId === 0x11 || objId === 0x1A) && idx + 4 <= rawHex.length) {
      res.windowOpen = parseInt(rawHex.substr(idx + 2, 2), 16) > 0;
      idx += 4;
    } else if (objId === 0x01 || objId === 0x15 || objId === 0x20 || objId === 0x21 || objId === 0x2E || objId === 0x46) {
      idx += 4;
    } else if (objId === 0x02 || objId === 0x03 || objId === 0x3F || objId === 0x40 || objId === 0x41 || objId === 0x43 || objId === 0x44 || objId === 0x45 || objId === 0x51 || objId === 0x52) {
      idx += 6;
    } else if (objId === 0x05 || objId === 0x42) {
      idx += 8;
    } else {
      break;
    }
  }
  return res;
}

function onBleScan(event, result) {
  if (event !== BLE.Scanner.SCAN_RESULT || !result || !result.addr) return;
  var mac = result.addr.toLowerCase();
  if (mac !== BLU_BUTTON_MAC && mac !== WIN1_MAC && mac !== WIN2_MAC) return;

  var bthomeData = result.service_data ? result.service_data["fcd2"] : null;
  if (!bthomeData) return;

  var hex = "";
  for (var i = 0; i < bthomeData.length; i++) {
    var h = bthomeData.charCodeAt(i).toString(16);
    hex += (h.length === 1 ? "0" : "") + h;
  }

  if (mac === BLU_BUTTON_MAC) {
    var btnData = parseBTHome(hex, lastBtnPkt, mac);
    if (btnData.valid) {
      lastBtnPkt = btnData.pktId;
      if (btnData.button) {
        var nextKomfort = !isKomfort;
        print("Taster gedrückt -> Wechsle zu " + (nextKomfort ? "Komfort" : "Eco"));
        applyModeChange(nextKomfort);
        if (inFlightCalls <= MAX_IN_FLIGHT_CALLS) {
          inFlightCalls++;
          Shelly.call("Boolean.Set", { id: SWITCH_ID, value: nextKomfort }, function () {
            inFlightCalls = Math.max(0, inFlightCalls - 1);
          });
        }
      }
    }
  } else if (mac === WIN1_MAC) {
    lastWin1Ms = Shelly.getUptimeMs();
    var w1Data = parseBTHome(hex, lastWin1Pkt, mac);
    if (w1Data.valid) {
      lastWin1Pkt = w1Data.pktId;
      if (w1Data.windowOpen !== null && w1Data.windowOpen !== win1Open) {
        win1Open = w1Data.windowOpen;
        print("Fenster Küche: " + (win1Open ? "OFFEN" : "ZU"));
        onWindowStateChanged();
      }
    }
  } else if (mac === WIN2_MAC) {
    lastWin2Ms = Shelly.getUptimeMs();
    var w2Data = parseBTHome(hex, lastWin2Pkt, mac);
    if (w2Data.valid) {
      lastWin2Pkt = w2Data.pktId;
      if (w2Data.windowOpen !== null && w2Data.windowOpen !== win2Open) {
        win2Open = w2Data.windowOpen;
        print("Wozi Fenster links: " + (win2Open ? "OFFEN" : "ZU"));
        onWindowStateChanged();
      }
    }
  }
}

BLE.Scanner.Subscribe(onBleScan);
if (BLE.Scanner.isRunning && !BLE.Scanner.isRunning()) {
  BLE.Scanner.Start({ duration_ms: BLE.Scanner.INFINITE_SCAN, active: false });
}

// === START-INITIALISIERUNG ===
loadState();
inFlightCalls++;
Shelly.call("Shelly.GetStatus", {}, function (res) {
  inFlightCalls = Math.max(0, inFlightCalls - 1);
  if (res) {
    var sw = res["boolean:" + SWITCH_ID];
    if (sw && typeof sw.value === "boolean") {
      isKomfort = sw.value;
    }

    var nKomfort = res["number:" + NUM_KOMFORT_ID];
    if (nKomfort && typeof nKomfort.value === "number") {
      tempKomfort = nKomfort.value;
    } else {
      Shelly.call("Number.Set", { id: NUM_KOMFORT_ID, value: tempKomfort });
    }

    var nEco = res["number:" + NUM_ECO_ID];
    if (nEco && typeof nEco.value === "number") {
      tempEco = nEco.value;
    } else {
      Shelly.call("Number.Set", { id: NUM_ECO_ID, value: tempEco });
    }

    var nLueften = res["number:" + NUM_LUEFTEN_ID];
    if (nLueften && typeof nLueften.value === "number") {
      tempLueften = nLueften.value;
    } else {
      Shelly.call("Number.Set", { id: NUM_LUEFTEN_ID, value: tempLueften });
    }

    for (var i = 0; i < TRV_IDS.length; i++) {
      var id = TRV_IDS[i];
      var trv = res["bthomedevice:" + id];
      if (trv && typeof trv.target_C === "number") {
        currentTrvTargets[String(id)] = trv.target_C;
      }
    }
  }
  Timer.set(2000, false, logStatus);
});
