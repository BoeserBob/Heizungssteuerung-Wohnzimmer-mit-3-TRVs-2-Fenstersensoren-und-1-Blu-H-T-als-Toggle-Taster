 *
 * Funktion:
 * Steuert 3x Shelly BLU TRV lokal anhand von 2 Fenstersensoren, Hauptschalter und App-Slidern:
 * - Hauptschalter (boolean:200 / BLU-Taster): Schaltet zwischen Komfort (number:200) und Eco (number:201).
 * - Fenstersensoren (ODER-Logik): Sichert aktuelle TRV-Sollwerte und setzt Lueften (number:202).
 * - Alle Fenster wieder ZU: Stellt vorherige TRV-Sollwerte wieder her (bzw. übernimmt
 *   einen während des Lüftens geänderten Komfort/Eco-Modus).
 *
 * Komponenten:
 * - Gateway:         Shelly BLU Gateway Gen3 (S3GW-1DBT001)
 * - Virtuell:        boolean:200 ("Wozi Heizung"), number:200 ("Komfort"),
 *                    number:201 ("Eco"), number:202 ("Lueften")
 * - Thermostate:     3x Shelly BLU TRV (bthomedevice:200, 201, 202)
 * - Taster:          Shelly BLU Button / BLU H&T (7c:c6:b6:80:05:7a)
 * - Fenstersensoren: Küche (f4:01:cc:21:d9:4f), Wozi links (f4:01:cc:21:dd:02)
 */

// === KONFIGURATION ===
var BLU_BUTTON_MAC       = "7c:c6:b6:80:05:7a"; // Taster (BLU H&T / BLU Button)
var WIN1_MAC             = "f4:01:cc:21:d9:4f"; // Fenster Küche
var WIN2_MAC             = "f4:01:cc:21:dd:02"; // Wozi Fenster links

var SWITCH_ID            = 200;              // boolean:200 (Wozi Heizung: true = Komfort, false = Eco)
var NUM_KOMFORT_ID       = 200;              // number:200 (Komfort)
var NUM_ECO_ID           = 201;              // number:201 (Eco)
var NUM_LUEFTEN_ID       = 202;              // number:202 (Lueften)
var TRV_IDS              = [200, 201, 202];  // bthomedevice:200, 201, 202

// Fallback-Temperaturen (falls ein Slider noch keinen Wert hat)
var tempKomfort          = 22;
var tempEco              = 16;
var tempLueften          = 5;
var LOG_INTERVAL_SEC     = 300;              // Zyklischer Log in Sekunden (300 = 5 Min., 0 = aus)

// Zustandsspeicher
var isKomfort            = true;   // true = Komfort, false = Eco
var win1Open             = false;
var win2Open             = false;
var windowOverride       = false;  // true, solange mindestens 1 Fenster offen ist
var modeChangedWhileOpen = false;
var savedTargets         = {};     // z. B. { "200": 22.0, "201": 21.5, "202": 22.0 }

var lastBtnPkt           = -1;
var lastWin1Pkt          = -1;
var lastWin2Pkt          = -1;
var lastWin1Ms           = -1;
var lastWin2Ms           = -1;
var encWarned            = {};

var callQueue            = [];
var isCalling            = false;

// === PERSISTENZ (Zustand über Neustarts hinweg sichern) ===
function saveState() {
  try {
    Script.storage.setItem("wozi_trv_preset_state", JSON.stringify({
      windowOverride: windowOverride,
      modeChangedWhileOpen: modeChangedWhileOpen,
      savedTargets: savedTargets
    }));
  } catch (e) {}
}

function loadState() {
  try {
    var raw = Script.storage.getItem("wozi_trv_preset_state");
    if (raw) {
      var data = JSON.parse(raw);
      if (typeof data.windowOverride === "boolean") windowOverride = data.windowOverride;
      if (typeof data.modeChangedWhileOpen === "boolean") modeChangedWhileOpen = data.modeChangedWhileOpen;
      if (data.savedTargets) savedTargets = data.savedTargets;
    }
  } catch (e) {}
}

// === 1. SEQUENZIELLE BLUETOOTH-RPC-WARTESCHLANGE ===
function processQueue() {
  if (callQueue.length === 0) {
    isCalling = false;
    return;
  }
  isCalling = true;
  var task = callQueue[0];
  var nextQueue = [];
  for (var i = 1; i < callQueue.length; i++) {
    nextQueue.push(callQueue[i]);
  }
  callQueue = nextQueue;

  if (task.action === "SAVE
