/**
 * Shelly BLU Gateway Gen3 – Heizungssteuerung Wohnzimmer
 * Funktion: Steuert 3 TRVs über 2 Fenstersensoren, Taster & App-Slider.
 */

// === 1. KONFIGURATION & ZUSTAND ===
var CFG = {
  MAC_BTN: "7c:c6:b6:80:05:7a",
  MAC_W1:  "f4:01:cc:21:d9:4f",
  MAC_W2:  "f4:01:cc:21:dd:02",
  TRVS:    [200, 201, 202],
  SW_ID:   200, N_KOMF: 200, N_ECO: 201, N_LUEFT: 202,
  T_STEP:  4000, T_VERIF: 20000, MAX_CALLS: 2, MAX_RETRIES: 1
};

var TEMPS = { komf: 22, eco: 16, lueft: 5 };

var ST = {
  komf: true, w1: false, w2: false, over: false, modePend: false,
  targets: {}, cache: {}, acked: {}, activePkt: {}, expected: {},
  inFlight: 0, q: [], tQ: null, tV: null, token: 0, retries: 0
};

// === 2. HILFSFUNKTIONEN & PERSISTENZ ===
function callRpc(method, params, cb) {
  ST.inFlight++;
  Shelly.call(method, params || {}, function (res, err, msg) {
    ST.inFlight = Math.max(0, ST.inFlight - 1);
    if (cb) cb(res, err, msg);
  });
}

function getTrvTargetFromStatus(res, id) {
  if (!res) return null;
  var c1 = res["blutrv:" + id];
  if (c1 && typeof c1.target_C === "number") return c1.target_C;
  var c2 = res["bthomedevice:" + id];
  if (c2 && typeof c2.target_C === "number") return c2.target_C;
  return null;
}

function saveState() {
  try {
    Script.storage.setItem("wozi_trv_state", JSON.stringify({ t: ST.targets }));
  } catch (e) { print("Fehler beim Speichern: " + e); }
}

function loadState() {
  try {
    var d = JSON.parse(Script.storage.getItem("wozi_trv_state") || "{}");
    ST.targets = d.t || {};
  } catch (e) { ST.targets = {}; }
  ST.over = false;
  ST.modePend = false;
}

// === 3. STEUERUNG & WARTESCHLANGE ===
function processQ(token) {
  if (token !== ST.token) return;

  if (ST.q.length === 0) {
    print("Prüfe Quittungen in " + Math.round(CFG.T_VERIF / 1000) + "s...");
    ST.tV = Timer.set(CFG.T_VERIF, false, function () { ST.tV = null; verifyQ(token); });
    return;
  }

  if (ST.inFlight >= CFG.MAX_CALLS) {
    ST.tQ = Timer.set(3000, false, function () { processQ(token); });
    return;
  }

  // mJS-kompatibler Shift-Ersatz
  var task = ST.q[0];
  var nextQ = [];
  for (var i = 1; i < ST.q.length; i++) nextQ.push(ST.q[i]);
  ST.q = nextQ;

  print("TRV " + task.id + " -> " + task.lbl + " (" + task.temp + " °C)");

  callRpc("BluTrv.Call", { id: task.id, method: "TRV.SetTarget", params: { id: 0, target_C: task.temp } }, function (r, e, m) {
    if (e === 0) {
      if (token === ST.token && ST.expected[task.id] === task.temp) {
        ST.acked[task.id] = true;
        ST.cache[task.id] = task.temp;
      }
      print("TRV " + task.id + ": Quittung OK (" + task.temp + " °C)");
    } else {
      print("TRV " + task.id + " Hinweis: " + m);
    }
  });

  ST.tQ = Timer.set(ST.q.length > 0 ? CFG.T_STEP : 100, false, function () { processQ(token); });
}

function verifyQ(token) {
  if (token !== ST.token) return;
  if (ST.inFlight >= CFG.MAX_CALLS) {
    ST.tV = Timer.set(5000, false, function () { ST.tV = null; verifyQ(token); });
    return;
  }

  callRpc("Shelly.GetStatus", {}, function (res) {
    if (token !== ST.token) return;
    var missing = [], log = [];

    for (var i = 0; i < CFG.TRVS.length; i++) {
      var id = CFG.TRVS[i], exp = ST.expected[id];
      var statusTemp = getTrvTargetFromStatus(res, id);
      if (statusTemp !== null) ST.cache[id] = statusTemp;

      var act = (statusTemp !== null) ? statusTemp : ST.cache[id];
      var ok = (ST.acked[id] === true) || (act === exp);

      if (ok) {
        ST.acked[id] = true;
        ST.cache[id] = exp;
        log.push(id + ":OK(" + exp + "°C)");
      } else {
        log.push(id + ":OFFEN(Ist " + (act !== undefined ? act + "°C" : "?") + " / Soll " + exp + "°C)");
        missing.push({ id: id, temp: exp, lbl: "Retry" });
      }
    }

    print("Prüfung (Rd " + (ST.retries + 1) + "): " + log.join(" | "));

    if (missing.length === 0) {
      print("Alle TRVs erfolgreich bestätigt.");
    } else if (ST.retries < CFG.MAX_RETRIES) {
      ST.retries++;
      ST.q = missing;
      processQ(token);
    } else {
      print("Hinweis: Max Retries erreicht.");
    }
  });
}

function enqueueAll(tempObj, lbl) {
  ST.token++; ST.retries = 0; ST.expected = {}; ST.acked = {}; ST.q = [];
  if (ST.tQ) { Timer.clear(ST.tQ); ST.tQ = null; }
  if (ST.tV) { Timer.clear(ST.tV); ST.tV = null; }

  for (var i = 0; i < CFG.TRVS.length; i++) {
    var id = CFG.TRVS[i];
    var t = tempObj !== null ? tempObj : (ST.targets[id] || (ST.komf ? TEMPS.komf : TEMPS.eco));
    ST.expected[id] = t;
    ST.q.push({ id: id, temp: t, lbl: lbl });
  }
  processQ(ST.token);
}

function updateLogic() {
  var open = ST.w1 || ST.w2;

  if (open && !ST.over) {
    var switchingInProgress = (ST.q.length > 0 || ST.tV !== null);
    ST.over = true;
    ST.modePend = false;

    if (switchingInProgress) {
      // Laufender Modus-Wechsel: gewählte Zieltemperatur direkt für alle TRVs sichern
      var targetModeTemp = ST.komf ? TEMPS.komf : TEMPS.eco;
      for (var i = 0; i < CFG.TRVS.length; i++) {
        ST.targets[CFG.TRVS[i]] = targetModeTemp;
      }
      saveState();
      print("Umschaltung lief noch -> Zielwert " + targetModeTemp + " °C für alle TRVs gesichert");
      enqueueAll(TEMPS.lueft, "Lueften");
    } else {
      // Ruhiger Betrieb: individuelle Sollwerte der TRVs auslesen und sichern
      callRpc("Shelly.GetStatus", {}, function (res) {
        if (!ST.over) return; // Falls Fenster schon wieder geschlossen wurde
        for (var i = 0; i < CFG.TRVS.length; i++) {
          var id = CFG.TRVS[i];
          var statusTemp = getTrvTargetFromStatus(res, id);
          ST.targets[id] = (statusTemp !== null) ? statusTemp : (ST.cache[id] || (ST.komf ? TEMPS.komf : TEMPS.eco));
          print("TRV " + id + ": Sollwert " + ST.targets[id] + " °C gesichert");
        }
        saveState();
        enqueueAll(TEMPS.lueft, "Lueften");
      });
    }
  } else if (!open && ST.over) {
    ST.over = false;
    if (ST.modePend) {
      ST.modePend = false;
      enqueueAll(ST.komf ? TEMPS.komf : TEMPS.eco, ST.komf ? "Komfort" : "Eco");
    } else {
      enqueueAll(null, "Restore");
    }
  }
}

function applyMode(isKomf) {
  ST.komf = isKomf;
  if (ST.over) {
    ST.modePend = true;
    print("Modus gemerkt, greift nach dem Schließen.");
  } else {
    enqueueAll(ST.komf ? TEMPS.komf : TEMPS.eco, ST.komf ? "Komfort" : "Eco");
  }
}

// === 4. EVENT & BLUETOOTH HANDLER ===
Shelly.addStatusHandler(function (e) {
  if (!e || !e.component) return;

  if ((e.component.indexOf("blutrv:") === 0 || e.component.indexOf("bthomedevice:") === 0) && e.delta && typeof e.delta.target_C === "number") {
    var trvId = parseInt(e.component.split(":")[1]);
    ST.cache[trvId] = e.delta.target_C;
    if (ST.expected[trvId] === e.delta.target_C) ST.acked[trvId] = true;
    return;
  }

  var v = (e.delta && e.delta.value !== undefined) ? e.delta.value : (e.info && e.info.value !== undefined ? e.info.value : null);
  if (v === null) return;

  if (e.component === "boolean:" + CFG.SW_ID && ST.komf !== v) applyMode(v);
  else if (e.component === "number:" + CFG.N_KOMF && v !== TEMPS.komf) { TEMPS.komf = v; if (ST.komf) applyMode(true); }
  else if (e.component === "number:" + CFG.N_ECO && v !== TEMPS.eco)   { TEMPS.eco = v;  if (!ST.komf) applyMode(false); }
  else if (e.component === "number:" + CFG.N_LUEFT && v !== TEMPS.lueft) { TEMPS.lueft = v; if (ST.over) enqueueAll(TEMPS.lueft, "Lueften"); }
});

function parseBT(hex, lastPkt) {
  var r = { pkt: lastPkt, btn: false, win: null };
  if (!hex || (parseInt(hex.substr(0, 2), 16) & 1)) return r;

  var i = 2;
  while (i + 2 <= hex.length) {
    var obj = parseInt(hex.substr(i, 2), 16), val = parseInt(hex.substr(i + 2, 2), 16);
    if (obj === 0x00) { if (val === lastPkt) return r; r.pkt = val; i += 4; }
    else if (obj === 0x3A) { r.btn = val > 0; i += 4; }
    else if (obj === 0x2D || obj === 0x11 || obj === 0x1A) { r.win = val > 0; i += 4; }
    else {
      var skip = [0x01,0x15,0x20,0x21,0x2E,0x46].indexOf(obj) >= 0 ? 4 :
                 [0x02,0x03,0x3F,0x40,0x41,0x43,0x44,0x45,0x51,0x52].indexOf(obj) >= 0 ? 6 :
                 [0x05,0x42].indexOf(obj) >= 0 ? 8 : 99;
      if (skip === 99) break;
      i += skip;
    }
  }
  return r;
}

BLE.Scanner.Subscribe(function (ev, res) {
  if (ev !== BLE.Scanner.SCAN_RESULT || !res || !res.service_data || !res.service_data.fcd2) return;
  var mac = res.addr.toLowerCase();
  if (mac !== CFG.MAC_BTN && mac !== CFG.MAC_W1 && mac !== CFG.MAC_W2) return;

  var hex = "";
  for (var i = 0; i < res.service_data.fcd2.length; i++) {
    var h = res.service_data.fcd2.charCodeAt(i).toString(16);
    hex += (h.length === 1 ? "0" : "") + h;
  }

  var d = parseBT(hex, ST.activePkt[mac] || -1);
  if (d.pkt === (ST.activePkt[mac] || -1)) return;
  ST.activePkt[mac] = d.pkt;

  if (mac === CFG.MAC_BTN && d.btn) {
    print("Taster -> Wechsle zu " + (!ST.komf ? "Komfort" : "Eco"));
    var nK = !ST.komf; applyMode(nK);
    callRpc("Boolean.Set", { id: CFG.SW_ID, value: nK });
  }
  else if (mac === CFG.MAC_W1 && d.win !== null && ST.w1 !== d.win) {
    ST.w1 = d.win; print("Fenster Küche: " + (ST.w1 ? "AUF" : "ZU")); updateLogic();
  }
  else if (mac === CFG.MAC_W2 && d.win !== null && ST.w2 !== d.win) {
    ST.w2 = d.win; print("Fenster Wozi: " + (ST.w2 ? "AUF" : "ZU")); updateLogic();
  }
});

// === 5. INITIALISIERUNG ===
if (BLE.Scanner.isRunning && !BLE.Scanner.isRunning()) {
  BLE.Scanner.Start({ duration_ms: BLE.Scanner.INFINITE_SCAN, active: false });
}
loadState();

callRpc("Shelly.GetStatus", {}, function (res) {
  if (!res) return;
  if (res["boolean:" + CFG.SW_ID]) ST.komf = res["boolean:" + CFG.SW_ID].value;

  var nK = res["number:" + CFG.N_KOMF], nE = res["number:" + CFG.N_ECO], nL = res["number:" + CFG.N_LUEFT];
  if (nK && typeof nK.value === "number") TEMPS.komf = nK.value; else callRpc("Number.Set", { id: CFG.N_KOMF, value: TEMPS.komf });
  if (nE && typeof nE.value === "number") TEMPS.eco = nE.value; else callRpc("Number.Set", { id: CFG.N_ECO, value: TEMPS.eco });
  if (nL && typeof nL.value === "number") TEMPS.lueft = nL.value; else callRpc("Number.Set", { id: CFG.N_LUEFT, value: TEMPS.lueft });

  for (var i = 0; i < CFG.TRVS.length; i++) {
    var id = CFG.TRVS[i];
    var t = getTrvTargetFromStatus(res, id);
    ST.cache[id] = (t !== null) ? t : (ST.komf ? TEMPS.komf : TEMPS.eco);
  }
  print("Skript gestartet. Modus: " + (ST.komf ? "Komfort" : "Eco"));
});
